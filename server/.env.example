# Copy this file to .env (same folder) and fill in the real values.
# .env is ignored by git on purpose. Never commit it.

# --- Database (Chad's RDS instance) ---
DB_HOST=g21-sts.cdgyae88wb3q.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Set to true only if RDS is configured to require SSL connections.
DB_SSL=false

# --- Server ---
PORT=3000
# Any long random string. Used to sign the login session cookie.
SESSION_SECRET=change-this-to-a-long-random-string

# --- Admin access ---
# Comma-separated list of account emails allowed to use the admin pages
# (create stocks, change market hours). Leave blank to allow any signed-in
# user during development. Replace with an IsAdmin column later.
ADMIN_EMAILS=
