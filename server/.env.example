# Copy this file to .env (same folder) and fill in the real values.
# .env is ignored by git on purpose. Never commit it.

# --- Database (Chad's RDS instance) ---
DB_HOST=g21-sts.cdgyae88wb3q.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Leave DB_NAME blank and the server finds the database that holds the UserAccount table.
DB_NAME=
# Set to true only if RDS is configured to require SSL connections.
DB_SSL=false

# --- Server ---
PORT=3000
# Any long random string. Used to sign the login session cookie.
SESSION_SECRET=change-this-to-a-long-random-string

# --- Admin access ---
# Admins are accounts with IsAdmin = 1 in UserAccount. At sign-up, a user who enters the
# password of this account in the "Admin Password" box becomes an admin.
ADMIN_ACCOUNT_EMAIL=admin@admin.com
# Optional: comma-separated extra emails to treat as admins regardless of IsAdmin.
ADMIN_EMAILS=
